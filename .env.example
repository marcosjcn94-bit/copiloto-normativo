# Provedor de LLM: github_models | azure_openai | ollama  (§3.2)
LLM_PROVIDER=github_models

# --- GitHub Models (padrão, free tier) ---
# Confirmar a URL corrente na documentação oficial antes da Fase 4 (§15, item 2)
GITHUB_MODELS_ENDPOINT=
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# --- Azure OpenAI (mesma API, muda endpoint e header) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Ollama (portabilidade open-source) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Persistência ---
# Dev: SQLite local. Azure: string de conexão PostgreSQL.
DATABASE_URL=sqlite:///data/catalogo.sqlite
CHROMA_DIR=data/chroma

# --- Observabilidade (Langfuse Cloud, free tier — Fase 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CRM falso (Fase 6) ---
CRM_BASE_URL=http://localhost:8001
