# Provedor de LLM: groq | azure_openai | ollama  (§3.2)
LLM_PROVIDER=groq

# --- Groq (padrão, free tier) ---
# Substituiu o GitHub Models, encerrado pela GitHub em 30/07/2026 (§15, item 2,
# verificado na Fase 4). API compatível com a da OpenAI; a chave sai de
# console.groq.com/keys e o free tier não exige cartão.
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_API_KEY=
# O llama-3.3-70b-versatile saiu do catálogo em 10/09/2026 (404 model_not_found).
# Substituto escolhido testando tool calling no catálogo vivo — ver llm/groq.py.
GROQ_MODEL=openai/gpt-oss-120b

# --- Azure OpenAI (mesma API, muda endpoint e header) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Ollama (portabilidade open-source) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Persistência ---
# Dev: SQLite local. Azure: string de conexão PostgreSQL.
DATABASE_URL=sqlite:///data/catalogo.sqlite
CHROMA_DIR=data/chroma

# Checkpoint do grafo (Fase 5) e da API (Fase 6). É aqui que a conversa
# interrompida no `interrupt()` espera a aprovação humana: apagar este arquivo
# perde as aprovações pendentes, não os dados do corpus.
CHECKPOINT_PATH=data/checkpoints.sqlite

# --- Observabilidade (Langfuse Cloud, free tier — Fase 7) ---
# Exige o extra: pip install -e ".[obs]". Sem as duas chaves abaixo, ou sem o
# pacote, o copiloto responde igual e apenas não emite trace — `GET /saude` diz
# em `componentes.observabilidade.motivo` qual dos dois está faltando.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# O SDK v4 renomeou esta variável para LANGFUSE_BASE_URL; o código aceita as duas.
LANGFUSE_HOST=https://cloud.langfuse.com
# Separa os traces do dev dos do Azure no mesmo projeto do free tier. Opcional.
LANGFUSE_ENVIRONMENT=development

# --- CRM falso (Fase 6) ---
# Vazio desliga a escrita externa: o grafo passa pela aprovação humana e diz que
# não gravou, em vez de fingir que gravou. Na demo, o CRM falso sobe pelo
# infra/docker-compose.yml e responde nesta porta.
CRM_BASE_URL=http://localhost:8001
